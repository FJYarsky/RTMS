# ==============================================================================
# RTMS — Reglas de exclusión de Git para entorno Windows y Python
# Desarrollado por Joaquín Yarsky (joaquinyarsky@gmail.com)
# ==============================================================================

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Binarios pesados (>100MB no permitidos en GitHub) y artefactos locales
bin/

# Entornos virtuales
venv/
.venv/
env/
ENV/

# PyInstaller / Build outputs
build/
dist/
*.spec

# Logs locales y telemetría
*.log
rtms.log
rtms_startup.log

# Configuraciones locales de hardware y respaldos
config/config.json
config/config.json.bak
config/config.json.tmp
config/config.json.*bak*
config/power_backup.json
config/mediamtx.yml
config/rtms.db*
*.db*
*.bak*
*_bak*
*.tmp

# IDEs & OS files
.vscode/
.idea/
.env
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary scratch test files
scratch/
*-help.txt
Docs 3.0.0/

# Test, linter & coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

