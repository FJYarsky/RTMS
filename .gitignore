# ==============================================================================
# RTMS v2.1.0 — Git Ignore Policy
# ==============================================================================

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Binarios pesados (>100MB no permitidos en GitHub)
bin/*.exe
bin/python/

# Entornos virtuales
venv/
.venv/
env/
ENV/

# PyInstaller / Build outputs
build/
dist/
*.spec

# Logs locales y telemetría
*.log
rtms.log
rtms_startup.log

# Configuraciones locales de hardware y respaldos
config/config.json
config/config.json.bak
config/config.json.tmp
config/power_backup.json
*.bak
*.tmp

# IDEs & OS files
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary scratch test files
scratch/
